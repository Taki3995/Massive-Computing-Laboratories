{
    "name": "Python Parallel Programming",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "features": {
        "ghcr.io/devcontainers/features/nvidia-cuda:1": {
            "installCudnn": false,
            "installToolkit": true
        }
    },
    "userEnvProbe": "none",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "remoteUser": "vscode",
    "runArgs": [
        "--gpus=all",
        "--volume=/tmp/.X11-unix:/tmp/.X11-unix:ro"
    ],
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}"
    }
}